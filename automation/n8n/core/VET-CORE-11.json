    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json;\nconst input = (raw && raw.body && typeof raw.body === 'object' && Object.keys(raw.body).length > 0) ? raw.body : raw;\n\nconst isApproved = input.approval_status === 'APPROVED' || input.referral_status === 'APPROVED';\nconst isBereaved = input.is_bereaved === true;\nconst isRevoked = input.caregiver_revoked === true;\nconst isOptOut = input.opt_out === true;\nconst hasSlot = input.is_slot_available === true;\nconst hasConfirmedBooking = typeof input.external_booking_reference === 'string' && input.external_booking_reference.length > 0;\n\nlet isEligible = false;\nlet dispatchType = 'NONE';\nlet suppressionReason = null;\nlet details = '';\n\nif (isBereaved) {\n  suppressionReason = 'BEREAVEMENT_PROTOCOL_SUPPRESSED';\n} else if (isRevoked) {\n  suppressionReason = 'CAREGIVER_REVOKED_SUPPRESSED';\n} else if (isOptOut) {\n  suppressionReason = 'CLIENT_OPT_OUT_SUPPRESSED';\n} else if (!isApproved) {\n  suppressionReason = 'UNAPPROVED_REFERRAL_DRAFT_SUPPRESSED';\n} else if (hasConfirmedBooking) {\n  isEligible = true;\n  dispatchType = 'EXTERNALLY_CONFIRMED_NOTICE';\n  details = `Cita confirmada externamente con ${input.specialist_name || 'especialista'} (${input.specialty_name || 'Especialidad'}) Ref: ${input.external_booking_reference}`;\n} else if (hasSlot) {\n  isEligible = true;\n  dispatchType = 'SPECIALIST_SLOT_OFFER';\n  details = `Propuesta de horario con ${input.specialist_name || 'especialista'} para ${input.slot_time || 'próxima fecha disponible'}`;\n} else {\n  suppressionReason = 'NO_SLOTS_AVAILABLE_ESCALATION_REQUIRED';\n}\n\nreturn {\n  json: {\n    referral_id: input.referral_id || 'unknown',\n    pet_name: input.pet_name || 'Mascota',\n    owner_name: input.owner_name || 'Tutor',\n    owner_phone: input.owner_phone || '+573000000000',\n    specialty_name: input.specialty_name || 'Especialidad',\n    specialist_name: input.specialist_name || 'Especialista',\n    is_approved: isApproved,\n    is_eligible: isEligible,\n    dispatch_type: dispatchType,\n    suppression_reason: suppressionReason,\n    details: details,\n    send_enabled: false,\n    evaluated_at: new Date().toISOString()\n  }\n};"
      },
