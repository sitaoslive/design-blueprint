      "name": "Validate Event Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        608
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json;\nconst input = (raw && raw.body && typeof raw.body === 'object' && Object.keys(raw.body).length > 0) ? raw.body : raw;\nconst errors = [];\nif (!input.event_id) errors.push('Missing event_id');\nif (!input.event_type) errors.push('Missing event_type');\nif (!input.aggregate_type) errors.push('Missing aggregate_type');\nif (!input.aggregate_id) errors.push('Missing aggregate_id');\nif (!input.idempotency_key) errors.push('Missing idempotency_key');\nif (!input.organization_id) errors.push('Missing organization_id');\nconst isValid = errors.length === 0;\nconst eventType = input.event_type || '';\nconst domain = eventType.split('.')[0] || 'unknown';\nreturn { json: { is_valid: isValid, errors: errors, event_id: input.event_id || null, event_type: eventType, domain: domain, aggregate_type: input.aggregate_type || null, aggregate_id: input.aggregate_id || null, idempotency_key: input.idempotency_key || null, organization_id: input.organization_id || null, payload: input.payload || {}, processed_at: new Date().toISOString() } };"
      }
