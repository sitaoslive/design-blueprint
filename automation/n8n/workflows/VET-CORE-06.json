    {
      "id": "0584affe-4e0d-48ed-967a-7e1e6e9e3123",
      "name": "Evaluate Calendar Sync & Triage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json;\nconst input = (raw && raw.body && typeof raw.body === 'object' && Object.keys(raw.body).length > 0) ? raw.body : raw;\n\nconst is410Gone = input.is_410_gone === true || input.status_code === 410 || input.error === 'syncTokenInvalid';\nconst isInternalEcho = input.is_internal_echo === true || input.source_origin === 'VET_FREEDOM_OS_OUTBOUND';\nconst isConflict = !is410Gone && !isInternalEcho && input.has_scheduled_vet_visit === true;\n\nlet branch = 'CLEAN_BUSY_SLOT';\nlet action = 'PERSIST_BUSY_SLOT';\nlet alertMsg = 'Calendar slot processed cleanly';\n\nif (is410Gone) {\n  branch = 'HTTP_410_RECOVERY';\n  action = 'RECOVER_INVALID_SYNC_TOKEN';\n  alertMsg = 'Google SyncToken expired (HTTP 410 Gone). Recovery mirror sync initiated.';\n} else if (isInternalEcho) {\n  branch = 'ANTI_LOOP_SUPPRESSION';\n  action = 'SUPPRESS_INTERNAL_ECHO';\n  alertMsg = 'Anti-loop invariant: Echo from internal outbound write suppressed.';\n} else if (isConflict) {\n  branch = 'CONFLICT_DETECTED';\n  action = 'RAISE_CALENDAR_CONFLICT';\n  alertMsg = 'Schedule conflict detected with appointment: ' + (input.conflicting_appointment_id || 'UNKNOWN');\n}\n\nreturn {\n  json: {\n    branch: branch,\n    action: action,\n    alert_message: alertMsg,\n    external_event_id: input.external_event_id || 'evt_gen_' + Date.now(),\n    staff_profile_id: input.staff_profile_id || 's1000000-0000-0000-0000-000000000001',\n    sanitized_summary: 'OCUPADO / NO DISPONIBLE (BUSY_ONLY)',\n    start_time: input.start_time || new Date().toISOString(),\n    end_time: input.end_time || new Date(Date.now() + 3600000).toISOString(),\n    sync_mode: 'BUSY_ONLY',\n    privacy_mode: 'BUSY_ONLY',\n    is_conflict_detected: isConflict,\n    conflicting_appointment_id: isConflict ? input.conflicting_appointment_id : null,\n    is_internal_echo: isInternalEcho,\n    is_410_gone: is410Gone,\n    sync_hash: 'hash_' + (input.external_event_id || '') + '_' + (input.start_time || ''),\n    safe_mode: {\n      send_enabled: false,\n      active: false,\n      write_to_personal_prohibited: true,\n      real_cancel_clinical_prohibited: true\n    },\n    synchronized_at: new Date().toISOString()\n  }\n};"
      }
    },
