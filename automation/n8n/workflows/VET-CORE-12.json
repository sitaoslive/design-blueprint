    {
      "id": "5503e066-2477-496d-8052-f35f54e0be6a",
      "name": "Evaluate Commitment Timeline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 96],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json;\nconst input = (raw && raw.body && typeof raw.body === 'object' && Object.keys(raw.body).length > 0) ? raw.body : raw;\n\nconst commitmentId = input.commitment_id || ('com-' + Date.now());\nconst visitId = input.visit_id || 'vis-default-001';\nconst caseId = input.case_id || 'case-default-001';\nconst commitmentType = input.commitment_type || 'SPECIALIST_REFERRAL';\nconst status = input.status || 'OPEN';\nconst elapsed = Number(input.hours_elapsed || 0);\nconst due = Number(input.due_hours || 24);\nconst isOverdue = (status === 'OPEN' || status === 'IN_PROGRESS') && (elapsed > due);\n\nconst isBereaved = Boolean(input.is_bereaved || input.bereavement_protocol_active);\nconst isCaregiverRevoked = Boolean(input.is_caregiver_revoked || input.caregiver_revoked);\nconst isClinicalDraft = Boolean(input.clinical_review_pending || input.is_unapproved_draft);\nconst isAIExtractedUnverified = input.source_provenance === 'INFERRED' && !input.human_validated;\n\nlet isEligible = true;\nlet suppressionReason = null;\nlet actionType = 'STANDARD_FOLLOWUP';\n\nif (isBereaved) {\n  isEligible = false;\n  suppressionReason = 'SUPPRESSED_BEREAVEMENT_PROTOCOL_ACTIVE';\n} else if (isCaregiverRevoked) {\n  isEligible = false;\n  suppressionReason = 'SUPPRESSED_CAREGIVER_PERMISSIONS_REVOKED';\n} else if (isClinicalDraft) {\n  isEligible = false;\n  suppressionReason = 'SUPPRESSED_UNAPPROVED_CLINICAL_DRAFT';\n} else if (isAIExtractedUnverified) {\n  isEligible = false;\n  suppressionReason = 'SUPPRESSED_UNVERIFIED_AI_PROMISE_HALLUCINATION_GUARD';\n} else if (isOverdue) {\n  actionType = 'ESCALATE_OVERDUE_COMMITMENT';\n}\n\nreturn {\n  json: {\n    case_id: caseId,\n    visit_id: visitId,\n    commitment_id: commitmentId,\n    commitment_type: commitmentType,\n    commitment_status: status,\n    is_eligible: isEligible,\n    suppression_reason: suppressionReason,\n    action_type: actionType,\n    is_overdue: isOverdue,\n    overdue_hours: isOverdue ? (elapsed - due) : 0,\n    staff_name: input.staff_name || 'Dr. Luis Ríos',\n    client_name: input.client_name || 'Cliente Vet Life',\n    pet_name: input.pet_name || 'Paciente',\n    phone: input.phone || '+573001234567',\n    due_at: input.due_at || new Date(Date.now() + due * 3600000).toISOString(),\n    evaluated_at: new Date().toISOString(),\n    send_enabled: false\n  }\n};"
      }
    },
