    {
      "id": "1eeae5e7-00c3-4261-8bb8-cf08a4f18667",
      "name": "Process NPS & Triage Satisfaction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json;\nconst input = (raw && raw.body && typeof raw.body === 'object' && Object.keys(raw.body).length > 0) ? raw.body : raw;\n\nconst comment = String(input.feedback_comment || input.comment || input.message || '').trim();\nconst lowerComment = comment.toLowerCase();\nconst score = Number(input.nps_score !== undefined ? input.nps_score : (input.score !== undefined ? input.score : 0));\nconst isBereaved = input.is_bereaved === true || input.is_deceased === true || input.sensitive_suppression === true;\nconst hasConsent = input.has_marketing_consent === true || input.allow_followup === true;\nconst hasOpenDispute = input.has_open_dispute === true || input.has_active_complaint === true;\n\n// 1. SUPRESIÓN POR DUELO O CASO SENSIBLE\nif (isBereaved) {\n  return [{\n    json: {\n      action: 'SUPPRESS_BEREAVEMENT_OR_SENSITIVE',\n      reason: 'Paciente fallecido o tutor en duelo/caso sensible. Prohibido contacto comercial o encuestas.',\n      survey_id: input.survey_id,\n      client_name: input.client_name,\n      client_phone: input.client_phone,\n      pet_name: input.pet_name,\n      is_eligible: false,\n      send_enabled: false,\n      evaluated_at: new Date().toISOString()\n    }\n  }];\n}\n\n// 2. DETECCIÓN DE PREOCUPACIÓN CLÍNICA / EMPEORAMIENTO (Guardrail de Seguridad Médica)\nconst clinicalKeywords = [\n  'vomitó', 'vomito', 'peor', 'sangre', 'decaído', 'decaido', 'empeoró', 'empeoro', \n  'reacción', 'reaccion', 'dolor', 'ahogando', 'convulsión', 'convulsion', 'fiebre', \n  'no come', 'letárgico', 'letargico', 'grave', 'infección', 'infeccion', 'hinchado', 'desmayo'\n];\nconst hasClinicalConcern = clinicalKeywords.some(kw => lowerComment.includes(kw)) || input.clinical_concern === true;\n\nif (hasClinicalConcern) {\n  return [{\n    json: {\n      action: 'CLINICAL_HANDOFF_CORE04',\n      target_module: 'VET-CORE-04',\n      priority: 'HIGH_CLINICAL',\n      reason: 'Mención de signos clínicos adversos o empeoramiento posvisita. Requiere valoración veterinaria inmediata, no atención de satisfacción.',\n      survey_id: input.survey_id,\n      client_name: input.client_name,\n      client_phone: input.client_phone,\n      pet_name: input.pet_name,\n      clinical_comment: comment,\n      requires_clinical_handoff: true,\n      send_enabled: false,\n      evaluated_at: new Date().toISOString()\n    }\n  }];\n}\n\n// 3. DETECCIÓN DE QUEJA / SERVICE RECOVERY\nconst complaintKeywords = [\n  'molesto', 'pésimo', 'pesimo', 'inconformidad', 'reclamo', 'queja', 'incumplimiento', \n  'mal servicio', 'cobro indebido', 'tarde', 'error', 'demora', 'nunca llegaron', 'irrespeto'\n];\nconst hasComplaintText = complaintKeywords.some(kw => lowerComment.includes(kw));\nconst isDetractor = (input.nps_score !== undefined && score <= 6) || hasComplaintText || input.is_complaint === true;\n\nif (isDetractor) {\n  return [{\n    json: {\n      action: 'SERVICE_RECOVERY_COMPLAINT',\n      target_module: 'VET-CORE-07',\n      priority: 'HIGH_OPS',\n      reason: 'Detractor o queja detectada. Requiere creación de caso de recuperación con SLA y llamada de seguimiento.',\n      survey_id: input.survey_id,\n      client_name: input.client_name,\n      client_phone: input.client_phone,\n      pet_name: input.pet_name,\n      nps_score: score,\n      feedback_comment: comment,\n      requires_service_recovery: true,\n      send_enabled: false,\n      evaluated_at: new Date().toISOString()\n    }\n  }];\n}\n\n// 4. INVITACIÓN A RESEÑA NEUTRAL (PROHIBICIÓN ESTRICTA DE REVIEW GATING)\nconst isReviewEligible = !hasOpenDispute && hasConsent && input.already_invited_review !== true;\nif (isReviewEligible && input.solicit_review === true) {\n  return [{\n    json: {\n      action: 'DISPATCH_NEUTRAL_REVIEW_INVITATION',\n      target_module: 'VET-CORE-03',\n      platform: 'GOOGLE_BUSINESS_PROFILE',\n      invitation_text: 'Te invitamos a compartir tu opinión sincera y transparente sobre nuestro servicio a domicilio en Google:',\n      review_url: 'https://g.page/r/vet-life-domicilio/review',\n      client_name: input.client_name,\n      client_phone: input.client_phone,\n      pet_name: input.pet_name,\n      nps_score: score,\n      is_review_eligible: true,\n      review_gating_prohibited: true,\n      send_enabled: false,\n      evaluated_at: new Date().toISOString()\n    }\n  }];\n}\n\n// 5. REGISTRO Y ARCHIVO NOMINAL ESTÁNDAR\nreturn [{\n  json: {\n    action: 'ARCHIVE_FEEDBACK_SATISFIED',\n    status: 'FEEDBACK_PROCESSED_NORMAL',\n    survey_id: input.survey_id,\n    client_name: input.client_name,\n    client_phone: input.client_phone,\n    pet_name: input.pet_name,\n    nps_score: score,\n    feedback_comment: comment,\n    is_eligible: true,\n    send_enabled: false,\n    evaluated_at: new Date().toISOString()\n  }\n}];"
      }
    },
