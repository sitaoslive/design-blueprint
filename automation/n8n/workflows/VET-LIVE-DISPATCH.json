      "parameters": {
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\n\n// REGLA FUNDAMENTAL DE PRIVACIDAD:\n// Solo se retorna la ubicación del profesional si el estado de la visita es estrictamente EN_ROUTE hacia ese domicilio.\nconst isEnRoute = (item.visit_status === 'EN_ROUTE');\nconst trackingToken = 'token_' + (item.appointment_id || 'apt') + '_sec256';\n\nreturn {\n  json: {\n    ...item,\n    tracking_token: trackingToken,\n    tracking_url: 'https://vetlife.app/t/' + trackingToken,\n    // Coordenadas acotadas estrictamente según estado\n    scoped_customer_location: (isEnRoute && item.coordinates) ? {\n      latitude: item.coordinates.latitude,\n      longitude: item.coordinates.longitude,\n      observedAt: item.coordinates.observedAt\n    } : null\n  }\n};"
      }
    },
